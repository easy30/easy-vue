# ============================================================
# easy-vue .gitignore
# ============================================================

# --- Node ---
node_modules/
npm-debug.log*
*.log
*.tsbuildinfo

# --- 所有隐藏文件/目录（.xxx / .xxx/） ---
# 排除必须保留的：.gitignore 本身、.github(若日后存 Actions)、.git
.??*
!.gitignore
!.github/
!.git/

# --- 构建产物（可再生成） ---
# 所有可执行文件/中间 C/调试符号统一输出到 bin/
bin/
dist/
.scriptc/
*.exe
*.dll
*.pdb

# --- Python demo（demo/python，setup.sh 生成，勿提交） ---
__pycache__/
*.pyc
demo/python/.venv/
# vendor 里的 vue/vue-router 是 setup.sh 从 CDN 下载的大文件，勿提交；
# devtools-api.js 是手写的必要 stub（vue-router 的 devtools 依赖），需跟踪。
demo/python/static/vendor/vue.esm-browser.js
demo/python/static/vendor/vue-router.esm-browser.js

# --- 系统/编辑器 ---
.DS_Store
.idea/
.vscode/
*.iml
Thumbs.db
Desktop.ini

# --- 临时 ---
*.c~
*.tmp
*.bak
/tmp/
